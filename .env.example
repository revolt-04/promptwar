# EcoAction AI Environment Configuration
# Copy this file to .env.local to configure your local environment
# NEVER commit real API keys or secrets to the repository!

# Optional: Google Gemini API Key for AI-enhanced actionable insights & custom tips
# If omitted or invalid, EcoAction AI runs seamlessly on its deterministic rule-based engine.
GEMINI_API_KEY=your_gemini_api_key_here
